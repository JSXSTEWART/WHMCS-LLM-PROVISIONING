################################################################################
# WHMCS LLM Provisioning System - Configuration Template
#
# Copy this file to config.env and update with your actual values
# IMPORTANT: Keep config.env out of version control (add to .gitignore)
################################################################################

# ==============================================================================
# Portainer Container Orchestration Configuration
# ==============================================================================

# Portainer API endpoint (with https://)
PORTAINER_URL=https://portainer.example.com

# Default Portainer admin credentials (change immediately after installation)
PORTAINER_ADMIN_USER=admin
PORTAINER_ADMIN_PASSWORD=changeme_immediately

# Portainer endpoint ID for Docker environment (usually 1 for primary)
PORTAINER_ENDPOINT_ID=1

# ==============================================================================
# Grafana Monitoring Dashboard Configuration
# ==============================================================================

# Domain for Grafana access (used in reverse proxy configuration)
GRAFANA_DOMAIN=grafana.example.com

# Grafana admin credentials (change after first login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_immediately

# Grafana organization settings
GRAFANA_ORG_NAME="LLM Provisioning"

# ==============================================================================
# Redis Cache Configuration
# ==============================================================================

# Redis server hostname (use container name from docker-compose)
REDIS_HOST=redis-cache

# Redis port
REDIS_PORT=6379

# Redis password (required for production)
REDIS_PASSWORD=changeme_immediately

# Redis database number (0-15)
REDIS_DB=0

# ==============================================================================
# CyberPanel Integration Configuration
# ==============================================================================

# CyberPanel API endpoint (with https://)
CYBERPANEL_API_URL=https://cyberpanel.example.com

# CyberPanel API key
CYBERPANEL_API_KEY=your_cyberpanel_api_key_here

# CyberPanel API password
CYBERPANEL_API_PASSWORD=your_cyberpanel_api_password_here

# Optional: Custom CA bundle path for self-signed certificates
# If using self-signed certs, provide path to CA file instead of disabling verification
CYBERPANEL_CA_BUNDLE=/path/to/ca-bundle.crt

# CyberPanel SSL notification email
CYBERPANEL_EMAIL=admin@example.com

# ==============================================================================
# WHMCS Integration Configuration
# ==============================================================================

# WHMCS base URL (with https://)
WHMCS_URL=https://whmcs.example.com

# WHMCS API credentials
WHMCS_API_KEY=your_whmcs_api_key_here
WHMCS_API_SECRET=your_whmcs_api_secret_here

# WHMCS database configuration
WHMCS_DB_HOST=localhost
WHMCS_DB_USER=whmcs
WHMCS_DB_PASSWORD=your_whmcs_db_password
WHMCS_DB_NAME=whmcs
WHMCS_DB_PORT=3306

# ==============================================================================
# LLM Container Configuration
# ==============================================================================

# Text Generation Inference (TGI) Docker image version
TGI_VERSION=2.0.0

# Default model for new deployments (one of: llama2-7b, llama2-13b, llama2-70b, mistral-7b, codelama-13b, phi-2)
DEFAULT_MODEL=llama2-7b

# Model quantization method (bfloat16, float16, int8, int4)
DEFAULT_QUANTIZE=bfloat16

# Health check interval in seconds
TGI_HEALTH_CHECK_INTERVAL=30

# Default resource limits for new containers
DEFAULT_MEMORY_GB=16
DEFAULT_CPU_CORES=4
DEFAULT_STORAGE_GB=50
DEFAULT_GPU_TYPE=tesla-t4

# Maximum concurrent inference requests
MAX_CONCURRENT_REQUESTS=100

# Request timeout for inference (seconds)
INFERENCE_TIMEOUT=120

# ==============================================================================
# SSL/TLS Certificate Configuration
# ==============================================================================

# Certificate validity period in days
SSL_CERT_VALIDITY_DAYS=365

# Enable automatic Let's Encrypt certificate provisioning
SSL_ENABLE_LETSENCRYPT=false

# Let's Encrypt email for certificate notifications
LETSENCRYPT_EMAIL=admin@example.com

# Let's Encrypt environment (staging or production)
LETSENCRYPT_ENVIRONMENT=production

# Path to self-signed certificate (if not using Let's Encrypt)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ==============================================================================
# Prometheus Monitoring Configuration
# ==============================================================================

# Prometheus metrics retention period (days)
PROMETHEUS_RETENTION_DAYS=30

# Prometheus scrape interval (seconds)
PROMETHEUS_SCRAPE_INTERVAL=15

# Prometheus evaluation interval (seconds)
PROMETHEUS_EVALUATION_INTERVAL=15

# ==============================================================================
# AlertManager Configuration
# ==============================================================================

# Alert resolution timeout (minutes)
ALERT_RESOLVE_TIMEOUT=5

# Critical alert notification email
CRITICAL_ALERT_EMAIL=critical-ops@example.com

# Operations team email for general alerts
OPS_ALERT_EMAIL=ops@example.com

# Alert email from address
ALERT_FROM_EMAIL=alerts@example.com

# SMTP server for alert notifications
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=your_smtp_password

# Slack webhook URL for critical alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# PagerDuty integration key (optional)
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_key

# ==============================================================================
# Security Configuration
# ==============================================================================

# API rate limiting (requests per second)
API_RATE_LIMIT=100

# API request timeout (seconds)
API_TIMEOUT_SECONDS=30

# Enable comprehensive audit logging
ENABLE_AUDIT_LOGGING=true

# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# API key rotation interval (days, 0 = disabled)
API_KEY_ROTATION_DAYS=90

# Maximum login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration (minutes)
LOCKOUT_DURATION_MINUTES=30

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log level for all services (debug, info, warn, error)
LOG_LEVEL=info

# Log file location
LOG_DIR=/var/log/llm-provisioning

# Maximum log file size (MB)
LOG_MAX_SIZE=100

# Log retention period (days)
LOG_RETENTION_DAYS=30

# ==============================================================================
# Advanced Configuration
# ==============================================================================

# Container image pull policy (always, never, ifNotPresent)
IMAGE_PULL_POLICY=ifNotPresent

# Docker network subnet
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Maximum number of concurrent container creations
MAX_CONCURRENT_CREATES=5

# Container startup timeout (seconds)
CONTAINER_STARTUP_TIMEOUT=300

# Health check grace period (seconds)
HEALTH_CHECK_GRACE_PERIOD=60

# ==============================================================================
# Development/Testing Configuration
# ==============================================================================

# Debug mode (0 = off, 1 = on)
DEBUG=0

# Skip SSL verification in development (NEVER use in production)
SKIP_SSL_VERIFICATION=false

# Test mode (disables actual container creation)
TEST_MODE=false

# ==============================================================================
# End of Configuration File
# ==============================================================================
