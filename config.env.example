# Configuration file for LLM Provisioning System
# Copy this file to .env and customize for your environment

# ==========================================
# WHMCS Configuration
# ==========================================
WHMCS_URL=https://your-whmcs.com
WHMCS_API_IDENTIFIER=your_identifier
WHMCS_API_SECRET=your_secret

# ==========================================
# Portainer Configuration
# ==========================================
PORTAINER_URL=https://portainer.example.com
PORTAINER_PORT=9443
PORTAINER_API_KEY=your_portainer_api_key
PORTAINER_ENDPOINT_ID=1

# Admin password (will be hashed on first run)
PORTAINER_ADMIN_PASSWORD=changeme_generate_secure_password

# ==========================================
# CyberPanel Configuration (Optional)
# ==========================================
CYBERPANEL_ENABLED=false
CYBERPANEL_URL=https://cyberpanel.example.com:8090
CYBERPANEL_API_TOKEN=your_cyberpanel_token

# ==========================================
# Hugging Face Configuration
# ==========================================
# Required for downloading models
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ==========================================
# GPU Configuration
# ==========================================
# Set to true if NVIDIA GPUs are available
GPU_ENABLED=true
# Default GPU type for new containers
DEFAULT_GPU_TYPE=nvidia-t4

# ==========================================
# Network Configuration
# ==========================================
DOMAIN=localhost
SUBNET=172.20.0.0/16

# External IP for container access
EXTERNAL_IP=0.0.0.0

# ==========================================
# Storage Configuration
# ==========================================
# Base directory for container data
LLM_DATA_DIR=/var/lib/llm-containers

# Default storage size per container (GB)
DEFAULT_STORAGE_SIZE=50

# ==========================================
# Resource Limits (Defaults)
# ==========================================
DEFAULT_MEMORY_LIMIT=8
DEFAULT_CPU_LIMIT=4
DEFAULT_MAX_INPUT_LENGTH=2048
DEFAULT_MAX_TOTAL_TOKENS=4096

# ==========================================
# Monitoring Configuration
# ==========================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_generate_secure_password

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info
LOG_FILE=/var/log/llm-provisioning/app.log

# ==========================================
# Security Configuration
# ==========================================
# Enable SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# API rate limiting (requests per second)
RATE_LIMIT=10
RATE_LIMIT_BURST=20

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# ==========================================
# Email Configuration
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# ==========================================
# Redis Configuration (Optional)
# ==========================================
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Backup Configuration
# ==========================================
BACKUP_ENABLED=false
BACKUP_DIR=/var/backups/llm-provisioning
BACKUP_RETENTION_DAYS=7

# ==========================================
# Advanced Configuration
# ==========================================
# Docker API version
DOCKER_API_VERSION=1.41

# Container restart policy
RESTART_POLICY=unless-stopped

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Maximum concurrent container deployments
MAX_CONCURRENT_DEPLOYMENTS=5

# Webhook timeout (seconds)
WEBHOOK_TIMEOUT=10

# Enable debug mode
DEBUG=false
